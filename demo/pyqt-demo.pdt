version = 0
sysroot = ""
sysroots_dir = ""
standard_library = [ "ssl", "sysconfig", "zlib", "importlib.resources",]
other_packages = [ "PyQt5.QtWidgets", "PyQt5.QtPurchasing", "PyQt5.QtDataVisualization", "PyQt5.Qsci", "PyQt5.QtChart", "PyQt5.Qt3DCore", "PyQt5.QtNetwork", "PyQt5.QtAndroidExtras", "PyQt5.QtX11Extras", "PyQt5.QtWinExtras", "PyQt5.QtMacExtras", "PyQt5.QtGui", "PyQt5.sip", "PyQt5.QtCore",]

[Application]
entry_point = ""
is_console = false
is_bundle = false
name = ""
qmake_configuration = ""
script = "pyqt-demo.py"
syspath = ""

[Application.Package]
name = "data"
exclude = [ "*.pyc", "*.pyd", "*.pyo", "*.pyx", "*.pxi", "__pycache__", "*-info", "EGG_INFO", "*.so",]
[[Application.Package.Content]]
name = "__init__.py"
included = true
is_directory = false

[[Application.Package.Content]]
name = "pyqt-demo.py.dat"
included = true
is_directory = false

